{
  "name": "@sontx/simplink-node",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http-peer": {
      "types": "./dist/http-peer.d.ts",
      "import": "./dist/http-peer.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "HTTP federation transport and peers for Simplink",
  "bin": {
    "simp-node": "dist/bin.js"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@sontx/simplink-core": "workspace:^",
    "ajv": "8.17.1",
    "commander": "14.0.3"
  }
}
