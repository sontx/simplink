{
  "name": "@sontx/simplink-core",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Markdown graph KB: loading, validation, resolution, search, and tools",
  "bin": {
    "simp": "dist/simp-cli.js",
    "simp-lint": "dist/cli.js",
    "simp-resolve": "dist/resolve-cli.js",
    "simp-search": "dist/search-cli.js",
    "simp-docs": "dist/docs-cli.js",
    "simp-index": "dist/index-cli.js"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.17.1",
    "commander": "14.0.3",
    "gray-matter": "4.0.3",
    "minisearch": "7.1.2"
  },
  "browser": {
    "./dist/platform.js": "./dist/platform-browser.js"
  }
}
