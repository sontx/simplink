{
  "name": "@sontx/simplink-ui",
  "version": "0.2.0",
  "description": "Local graph manager and live docs preview for Simplink knowledge bases",
  "type": "module",
  "license": "MIT",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "bin": {
    "simp-ui": "dist/server/bin.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force && vite build && tsc -p tsconfig.web.json",
    "test": "tsx --test test/*.test.ts",
    "dev": "node dev.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@sontx/simplink-core": "workspace:^",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.4.0"
  }
}
