{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb.local/schemas/simp.schema.json",
  "title": "KB simp",
  "type": "object",
  "allOf": [
    {
      "$ref": "defs.schema.json#/$defs/common"
    }
  ],
  "required": ["name"],
  "properties": {
    "type": {
      "const": "simp"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "docs_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
    },
    "serves": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["pull", "delegate"]
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "defs.schema.json#/$defs/slug"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["pull", "delegate"]
          },
          "docs_url": {
            "type": "string",
            "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
