{
  "name": "simplink-workspace",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/link-agent-skills.mjs",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint . --fix",
    "format": "prettier --write .",
    "test": "pnpm build && pnpm -r test",
    "lint:kb": "node packages/core/dist/cli.js kb",
    "gen:docs": "node packages/core/dist/docs-cli.js",
    "dev": "tsx packages/core/src/cli.ts kb",
    "start:http": "node packages/mcp/dist/http-bin.js --kb kb",
    "node": "node packages/node/dist/bin.js",
    "ui": "pnpm --filter @sontx/simplink-ui preview",
    "dev:ui": "pnpm --filter @sontx/simplink-ui dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.6",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "!(*.{js,mjs,cjs,ts,mts,cts})": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22"
  }
}
