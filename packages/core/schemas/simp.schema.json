{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb.local/schemas/simp.schema.json",
  "title": "KB simp",
  "type": "object",
  "allOf": [
    {
      "$ref": "defs.schema.json#/$defs/common"
    }
  ],
  "required": ["name"],
  "properties": {
    "type": {
      "const": "simp"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "docs_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"
    },
    "serves": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["pull", "delegate"]
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "updated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?(?:[Zz]|[+-]\\d{2}(?::?\\d{2})?)?)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "defs.schema.json#/$defs/slug"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["pull", "delegate"]
          },
          "docs_url": {
            "type": "string",
            "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
